# Dense scoring matrix cache: a rebuildable artifact the size of every
# vector in the vault, written beside the database.
*.vecmat.npy
*.vecmat.sig

# Orphaned temps if a write is killed mid-flight.
*.vecmat.*.tmp
grimore.pid
grimore.log
*.pid
*.log
backups/

# Runtime state under the developer's test vault is local. The reference corpus
# itself is versioned so Phase-0 evidence checks are reproducible on a clone.
test_vault/*
!test_vault/test_vault/
!test_vault/test_vault/*
# Third-party papers kept for manual testing only; not redistributable.
test_vault/test_vault/*.pdf
!test_vault/test_vault/informe_humedal_*.pdf

# Your local config: vault path, model names and timeouts are all
# machine-specific. Copy grimore.toml.example and edit that instead.
grimore.toml

# Local editor/tooling config
.claude/

# Benchmark artifacts. The harness scripts are tracked; the vault it
# generates, its throwaway workspace and the measured numbers are not --
# make_vault.py reproduces the vault byte-for-byte from its seed.
bench/vault/
bench/work/
bench/results*.json
eval/results/

# Internal planning notes.
GRI/
docs/New_developments

# Pseudonymous pilot records are local research data, not repository fixtures.
pilot-data/

