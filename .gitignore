# Your local config: vault path, model names and timeouts are all
# machine-specific. Copy grimore.toml.example and edit that instead.
grimore.toml

# Local editor/tooling config
.claude/

# Benchmark artifacts. The harness scripts are tracked; the vault it
# generates, its throwaway workspace and the measured numbers are not --
# make_vault.py reproduces the vault byte-for-byte from its seed.
bench/vault/
bench/work/
bench/results*.json

