# Grimore — local-first runtime configuration
# Copy to .env (git-ignored); Grimore reads it from the current directory only.
#
# OLLAMA_HOST selects the Ollama server for chat and embeddings. A non-loopback
# host is refused unless [cognition].allow_remote is true in grimore.toml (and
# the URL is https).
#
# The OpenAI-compatible backend ([cognition].llm_backend = "openai") also reads
# OPENAI_BASE_URL (when llm_base_url is unset) and a bearer token from the
# variable named by [cognition].llm_api_key_env, GRIMORE_LLM_API_KEY by default.
# Set them in your own .env if you use it; they are intentionally not listed
# here so no real key ends up in this tracked file.
OLLAMA_HOST=http://localhost:11434
